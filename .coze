[project]
requires = ["python-3.12", "nodejs-24"]

[dev]
build = ["pip", "install", "-r", "requirements.txt"]
run = ["sh", "-c", "cd /workspace/projects && python3 -u app.py"]

[deploy]
build = ["pip", "install", "-r", "requirements.txt"]
run = ["sh", "-c", "cd /workspace/projects && python3 -u app.py"]